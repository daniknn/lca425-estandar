{
  "description": "Muros del curso LCA425: protege main, bloquea force push y --no-verify, y exige saldo (y cotización cuando se puede) antes de gastar créditos en Higgsfield.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/proteger-git.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*__(generate_(video|image|audio|3d)(_batch)?|execute_preset|upscale_(image|video)|outpaint_image|remove_background|reframe|ads_studio_generate|ai_influencer_generate|build_ai_influencer|shorts_studio_create|scene_builder_3d_generate_(video|angles)|motion_control|dubbing|voice_change|create_voice(_from_confirmed_audio)?|apps_invoke)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/saldo-higgsfield.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
